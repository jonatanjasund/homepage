---
interface Props {
  count: number;
  empty?: string;
}

const { count, empty = 'Nothing here yet.' } = Astro.props;
---

{count > 0 ? <div class="list"><slot /></div> : <p class="empty">{empty}</p>}

<style>
  .list {
    display: grid;
    gap: 0.75rem;
  }

  .empty {
    color: var(--muted);
    font-style: italic;
  }
</style>
